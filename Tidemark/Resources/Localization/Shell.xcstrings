{
  "sourceLanguage" : "en",
  "strings" : {
    "Cancel" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取消"
          }
        }
      }
    },
    "Every request Surge sees will be saved to PostgreSQL again, and alerts turn back on. Nothing from the paused period is filled in." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Surge 看到的每个请求会重新写入 PostgreSQL，提醒也会恢复。暂停期间的请求不会补录。"
          }
        }
      }
    },
    "Pause" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暂停"
          }
        }
      }
    },
    "Pause recording?" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暂停记录？"
          }
        }
      }
    },
    "Requests Surge handles from now on won't be saved to PostgreSQL, and no new-site alerts will fire until you resume. Recording turns back on by itself the next time Tidemark starts." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从现在起 Surge 处理的请求不会写入 PostgreSQL，也不会再有新站点提醒，直到你恢复记录。下次 Tidemark 启动时会自动恢复记录。"
          }
        }
      }
    },
    "Resume" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "恢复"
          }
        }
      }
    },
    "Resume recording?" : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "恢复记录？"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
