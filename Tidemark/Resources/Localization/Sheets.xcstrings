      }
    },
    "Everything this app and its child processes send is collected under it, deduplicated by domain and IP." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个 App 和它的子进程发出的所有请求都归到它名下，并按域名和 IP 去重。"
