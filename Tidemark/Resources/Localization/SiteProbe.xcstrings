    "Send Global Privacy Control" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "发送全局隐私控制（GPC）"
          }
        }
      }
    },
    "Send Global Privacy Control: tells sites not to sell or share your data (the Sec-GPC header), like Safari's privacy setting. Applies from the next page load." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "发送全局隐私控制（GPC）：告诉网站不要出售或共享你的数据（Sec-GPC 请求头），和 Safari 的隐私设置一样。从下一次页面加载开始生效。"
          }
        }
      }
    },
    "Sessions" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
