    "A Stop pressed right after the page loaded keeps recording until 6 s after the load, so the page's late requests are still caught." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "页面刚加载完就按下停止时，会继续记录到加载完成后 6 秒，页面较晚发出的请求也能记下来。"
          }
        }
      }
    },
