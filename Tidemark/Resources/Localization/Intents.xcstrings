        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "记录"
          }
        }
      }
    },
    "Recording paused. Requests Surge handles from now on won't be saved to PostgreSQL, and no new-site alerts will fire until you resume." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已暂停记录。从现在起 Surge 处理的请求不会写入 PostgreSQL，也不会再有新站点提醒，直到你恢复记录。"
          }
        }
      }
    },
    "Recording resumed. Every request Surge sees will be saved to PostgreSQL again, and alerts turn back on." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已恢复记录。Surge 看到的每个请求会重新写入 PostgreSQL，提醒也会恢复。"
          }
        }
      }
    },
